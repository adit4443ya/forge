# Supabase — create a project at https://supabase.com, then Project Settings > API.
# WITHOUT these the app still works: progress is saved in the browser only.
# WITH them you get Google sign-in and progress that follows you between devices.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: where OAuth returns to. Defaults to the request origin.
# NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app
